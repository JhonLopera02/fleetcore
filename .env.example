PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fleetcore
# true = TypeORM crea/ajusta las tablas al arrancar (útil en desarrollo y para la prueba)
